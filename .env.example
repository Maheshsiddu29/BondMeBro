# Network / deployment
RPC_URL=https://your-rpc-endpoint
PRIVATE_KEY=0xreplace-me
POOL_MANAGER=0x0000000000000000000000000000000000000000
OWNER=0x0000000000000000000000000000000000000000

# BondMeBro deployment policy (immutable values are part of the CREATE2 address)
# BOND_BPS is capped at 100 (1%). Set all three custody values to non-zero to enable it.
# This safe template defaults to disabled custody; choose a rate and thresholds before launch.
BOND_BPS=0
MIN_BONDED_AMOUNT0=0
MIN_BONDED_AMOUNT1=0
REFUND_TOL_TICKS=10
OBSERVATION_BLOCKS=20
MAX_ABS_TICK_DELTA=506
SETTLER_FEE_BPS=500
MAX_SETTLES_PER_SWAP=4

# Pool operations scripts
BOND_HOOK=0x0000000000000000000000000000000000000000
CURRENCY0=0x0000000000000000000000000000000000000000
CURRENCY1=0x0000000000000000000000000000000000000000
POOL_FEE=3000
TICK_SPACING=60
SQRT_PRICE_X96=79228162514264337593543950336

# Canonical PositionManager liquidity provisioning
POSITION_MANAGER=0x0000000000000000000000000000000000000000
PERMIT2=0x0000000000000000000000000000000000000000
LIQUIDITY_OWNER=0x0000000000000000000000000000000000000000
TICK_LOWER=-887220
TICK_UPPER=887220
LIQUIDITY=1000000000000000000
AMOUNT0_MAX=340282366920938463463374607431768211455
AMOUNT1_MAX=340282366920938463463374607431768211455
NATIVE_VALUE=0

# Optional per-pool update script (broadcaster must be OWNER)
POOL_MIN_BONDED_AMOUNT0=0
POOL_MIN_BONDED_AMOUNT1=0
POOL_BOND_BPS=0

MAX_COUNT=32
POT_CURRENCY=0x0000000000000000000000000000000000000000

# Universal Router swap smoke test
UNIVERSAL_ROUTER=0x0000000000000000000000000000000000000000
TRADER=0x0000000000000000000000000000000000000000
ZERO_FOR_ONE=true
SWAP_AMOUNT_IN=10000000000000000
SWAP_AMOUNT_OUT_MINIMUM=0
SWAP_AMOUNT_OUT=5000000000000000
SWAP_AMOUNT_IN_MAXIMUM=10000000000000000
MAX_BOND_AMOUNT=340282366920938463463374607431768211455
